#!/bin/bash
# trmnl — Terminal IDE manager
set -e

TRMNL_VERSION="0.1.2"
if [ -z "${TRMNL_DIR:-}" ]; then
    if command -v brew >/dev/null; then
        TRMNL_DIR="$(brew --prefix)/share/trmnl"
    else
        TRMNL_DIR="$HOME/.local/share/trmnl"
    fi
fi
case "$TRMNL_DIR" in /*) ;; *) echo "TRMNL_DIR must be absolute" >&2; exit 1 ;; esac
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_DIR="$CONFIG_DIR/.trmnl-links"

# Exact full-line delimiters shared by setup, doctor and uninstall.
SHELL_START='# ── trmnl Terminal IDE ──────────────────────────────────────────'
SHELL_END='# ── End trmnl Configuration ──────────────────────────────────────'

# Write only to a caller-owned temporary file. Reject incomplete/nested blocks
# rather than consuming unrelated user content after an unmatched marker.
shell_content() {
    local input="$1" output="$2" block="${3:-}"
    awk -v start="$SHELL_START" -v end="$SHELL_END" '
        $0 == start { if (inside) exit 2; inside=1; next }
        $0 == end { if (!inside) exit 2; inside=0; next }
        !inside { print }
        END { if (inside) exit 2 }
    ' "$input" > "$output" || return 1
    [ -z "$block" ] || cat "$block" >> "$output"
}

source_preflight() {
    local item
    for item in nvim/init.lua zellij/config.kdl zellij/layouts/dev.kdl zellij/plugins/zellij-autolock.wasm yazi/yazi.toml yazi/keymap.toml yazi/theme.toml ghostty/config starship.toml trmnl-gitconfig zshrc-block; do
        [ -s "$TRMNL_DIR/$item" ] || { echo "Missing source: $TRMNL_DIR/$item" >&2; return 1; }
    done
    [ "$(head -n 1 "$TRMNL_DIR/zshrc-block")" = "$SHELL_START" ] &&
        [ "$(tail -n 1 "$TRMNL_DIR/zshrc-block")" = "$SHELL_END" ] || {
        echo 'Invalid shell block delimiters' >&2; return 1;
    }
    bash -n "$TRMNL_DIR/zshrc-block"
}

# ── Colors ──────────────────────────────────────────
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

banner() {
    echo ""
    echo -e "${BLUE}${BOLD}  ┌─────────────────────────────┐${NC}"
    echo -e "${BLUE}${BOLD}  │  trmnl ${DIM}v${TRMNL_VERSION}${NC}${BLUE}${BOLD}                │${NC}"
    echo -e "${BLUE}${BOLD}  │  Terminal IDE               │${NC}"
    echo -e "${BLUE}${BOLD}  └─────────────────────────────┘${NC}"
    echo ""
}

# Recovery uses successful filesystem transitions, not pre-command flags.
# Intent files precede commands; backup/candidate existence resolves the signal
# window between a command completing and the shell handling HUP/INT/TERM.
path_exists() { [ -e "$1" ] || [ -L "$1" ]; }

recover_transaction() {
    local txn="$1" kind item dest entry
    kind="$(cat "$txn/kind")" || return 1
    case "$kind" in setup|uninstall) ;; *) return 1 ;; esac
    for item in zshrc gitconfig; do
        if [ -f "$txn/publish-$item" ] && [ ! -e "$txn/$item" ]; then
            if [ -f "$txn/old-$item" ]; then
                cp -p "$txn/old-$item" "$txn/recover-$item" || return 1
                mv "$txn/recover-$item" "$HOME/.$item" || return 1
            else
                rm -f "$HOME/.$item" || return 1
            fi
            rm "$txn/publish-$item" || return 1
        fi
    done
    if [ "$kind" = setup ]; then
        if [ -d "$txn/journal-before" ]; then
            [ ! -e "$STATE_DIR" ] || rm -rf "$STATE_DIR" || return 1
            mv "$txn/journal-before" "$STATE_DIR" || return 1
        elif [ -f "$txn/journal-absent" ] && [ ! -d "$txn/journal" ]; then
            [ ! -e "$STATE_DIR" ] || rm -rf "$STATE_DIR" || return 1
        fi
        for item in nvim zellij yazi starship.toml; do
            dest="$CONFIG_DIR/$item"
            if path_exists "$txn/targets/$item"; then
                if path_exists "$dest"; then
                    [ -L "$dest" ] && [ "$(readlink "$dest")" = "$TRMNL_DIR/$item" ] || return 1
                    rm "$dest" || return 1
                fi
                mv "$txn/targets/$item" "$dest" || return 1
            elif [ -f "$txn/absent-$item" ]; then
                if path_exists "$dest"; then
                    [ -L "$dest" ] && [ "$(readlink "$dest")" = "$TRMNL_DIR/$item" ] || return 1
                    rm "$dest" || return 1
                fi
            fi
        done
    else
        for item in nvim zellij yazi starship.toml; do
            dest="$CONFIG_DIR/$item"; entry="$STATE_DIR/$item"
            if [ -d "$txn/entries/$item" ]; then
                [ ! -e "$entry" ] || return 1
                mv "$txn/entries/$item" "$entry" || return 1
            fi
            if path_exists "$txn/removed-$item"; then
                if [ -f "$txn/previous-$item" ] && ! path_exists "$entry/previous"; then
                    path_exists "$dest" || return 1
                    mv "$dest" "$entry/previous" || return 1
                fi
                ! path_exists "$dest" || return 1
                mv "$txn/removed-$item" "$dest" || return 1
            fi
        done
    fi
}

finish_transaction() {
    local status=$?
    trap - EXIT
    # Recovery cannot itself be interrupted by a second catchable signal.
    trap '' HUP INT TERM
    if [ "$status" -ne 0 ] && ! recover_transaction "$txn"; then
        echo "Recovery incomplete; retained private transaction: $txn" >&2
        printf 'Retry with the same HOME, XDG_CONFIG_HOME and TRMNL_DIR: trmnl recover %q\n' "$txn" >&2
        exit "$status"
    fi
    rm -rf "$txn"
    exit "$status"
}

cmd_recover() (
    set -e
    umask 077
    txn="${1:-}"
    case "$txn" in "$HOME"/.trmnl-setup.*|"$HOME"/.trmnl-uninstall.*) ;; *) echo 'Invalid recovery path' >&2; exit 1 ;; esac
    [ -d "$txn" ] && [ ! -L "$txn" ] || exit 1
    # Bind recovery to the original destinations; metadata is data, never code.
    [ "$(cat "$txn/home")" = "$HOME" ] &&
        [ "$(cat "$txn/config")" = "$CONFIG_DIR" ] &&
        [ "$(cat "$txn/source")" = "$TRMNL_DIR" ] || { echo 'Recovery environment differs' >&2; exit 1; }
    trap '' HUP INT TERM
    if ! recover_transaction "$txn"; then
        echo "Recovery incomplete; retained private transaction: $txn" >&2
        exit 1
    fi
    rm -rf "$txn"
    echo 'Restored pre-transaction configuration.'
)

refuse_pending_recovery() {
    local pending
    for pending in "$HOME"/.trmnl-setup.* "$HOME"/.trmnl-uninstall.*; do
        [ -d "$pending" ] && [ ! -L "$pending" ] || continue
        if [ -f "$pending/kind" ] && [ "$(cat "$pending/config")" = "$CONFIG_DIR" ]; then
            printf 'Pending recovery; run with the original environment: trmnl recover %q\n' "$pending" >&2
            return 1
        fi
    done
}

prepare_transaction() {
    printf '%s\n' "$1" > "$txn/kind"
    printf '%s\n' "$HOME" > "$txn/home"
    printf '%s\n' "$CONFIG_DIR" > "$txn/config"
    printf '%s\n' "$TRMNL_DIR" > "$txn/source"
    mkdir "$txn/targets" "$txn/entries" "$txn/journal"
    trap finish_transaction EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

# ── Setup ───────────────────────────────────────────
cmd_setup() (
    set -e
    umask 077
    source_preflight
    banner
    case "$CONFIG_DIR" in /*) ;; *) echo 'XDG_CONFIG_HOME must be absolute' >&2; exit 1 ;; esac
    # Never interpret a manifest as shell code or follow a journal symlink.
    [ ! -L "$STATE_DIR" ] || { echo 'Refusing symlink journal' >&2; exit 1; }
    for file in "$HOME/.zshrc" "$HOME/.gitconfig"; do
        [ ! -L "$file" ] && { [ ! -e "$file" ] || [ -f "$file" ]; } || {
            echo "Refusing non-regular configuration file: $file" >&2; exit 1;
        }
    done
    command -v git >/dev/null || { echo 'git is required for setup' >&2; exit 1; }
    txn='' item='' src='' dest='' current='' entry=''
    refuse_pending_recovery
    txn="$(mktemp -d "$HOME/.trmnl-setup.XXXXXXXX")"
    prepare_transaction setup
    if [ -d "$STATE_DIR" ]; then
        for item in nvim zellij yazi starship.toml; do
            [ ! -L "$STATE_DIR/$item" ] && [ ! -L "$STATE_DIR/$item/owned" ] || {
                echo 'Refusing symlink journal entry' >&2; exit 1;
            }
        done
        cp -pRP "$STATE_DIR/." "$txn/journal/"
    fi
    if [ -f "$HOME/.zshrc" ]; then cp -p "$HOME/.zshrc" "$txn/old-zshrc"; else : > "$txn/input-zshrc"; fi
    shell_content "${txn}/$(if [ -f "$txn/old-zshrc" ]; then echo old-zshrc; else echo input-zshrc; fi)" "$txn/zshrc" "$TRMNL_DIR/zshrc-block"
    [ ! -f "$HOME/.zshrc" ] || chmod "$(stat -f %Lp "$HOME/.zshrc" 2>/dev/null || stat -c %a "$HOME/.zshrc")" "$txn/zshrc"
    if [ -f "$HOME/.gitconfig" ]; then cp -p "$HOME/.gitconfig" "$txn/old-gitconfig"; cp -p "$HOME/.gitconfig" "$txn/gitconfig"; else : > "$txn/gitconfig"; fi
    if ! git config --file "$txn/gitconfig" --get-all include.path | grep -Fxq "$TRMNL_DIR/trmnl-gitconfig"; then
        git config --file "$txn/gitconfig" --add include.path "$TRMNL_DIR/trmnl-gitconfig"
    fi
    mkdir -p "$CONFIG_DIR"
    for item in nvim zellij yazi starship.toml; do
        src="$TRMNL_DIR/$item"; dest="$CONFIG_DIR/$item"; entry="$txn/journal/$item"
        current=''
        [ ! -L "$dest" ] || current="$(readlink "$dest")"
        if [ -L "$dest" ] && [ -s "$entry/owned" ] && [ ! -L "$entry/owned" ] && [ "$current" = "$(cat "$entry/owned")" ]; then
            : # Preserve the original predecessor across repeated setup.
        else
            # Keep older displaced predecessors if the user changed this link.
            if [ -e "$entry" ]; then
                mkdir -p "$txn/journal/history"
                mv "$entry" "$(mktemp -d "$txn/journal/history/$item.XXXXXXXX")/entry"
            fi
            mkdir "$entry"
            if [ -e "$dest" ] || [ -L "$dest" ]; then cp -pRP "$dest" "$entry/previous"; fi
        fi
        printf '%s\n' "$src" > "$entry/owned"
        if path_exists "$dest"; then
            mv "$dest" "$txn/targets/$item"
        else
            : > "$txn/absent-$item"
        fi
        ln -s "$src" "$dest"
    done
    if [ -d "$STATE_DIR" ]; then
        mv "$STATE_DIR" "$txn/journal-before"
    else
        : > "$txn/journal-absent"
    fi
    mv "$txn/journal" "$STATE_DIR"
    : > "$txn/publish-gitconfig"
    mv "$txn/gitconfig" "$HOME/.gitconfig"
    : > "$txn/publish-zshrc"
    mv "$txn/zshrc" "$HOME/.zshrc"
    echo 'Setup complete. Previous configurations are retained in the owned-link journal.'
)

# ── Keys ────────────────────────────────────────────
cmd_keys() {
    echo ""
    echo -e "${BLUE}${BOLD}  Zellij${NC}"
    echo -e "  ${DIM}──────────────────────────────────────${NC}"
    echo -e "  ${BOLD}Ctrl+p${NC}  Pane mode"
    echo -e "    ${GREEN}a${NC}  new pane left     ${GREEN}r${NC}  new pane right"
    echo -e "    ${GREEN}d${NC}  new pane down     ${GREEN}b${NC}  new pane bottom"
    echo -e "    ${GREEN}n${NC}  new pane (auto)   ${GREEN}s${NC}  new stacked pane"
    echo -e "    ${GREEN}w${NC}  toggle floating   ${GREEN}f${NC}  toggle fullscreen"
    echo -e "    ${GREEN}x${NC}  close pane        ${GREEN}e${NC}  embed/float toggle"
    echo -e "    ${GREEN}h/j/k/l${NC}  move focus"
    echo ""
    echo -e "  ${BOLD}Ctrl+t${NC}  Tab mode"
    echo -e "    ${GREEN}n${NC}  new tab           ${GREEN}x${NC}  close tab"
    echo -e "    ${GREEN}r${NC}  rename tab        ${GREEN}1-9${NC}  go to tab"
    echo ""
    echo -e "  ${BOLD}Ctrl+n${NC}  Resize mode  ${DIM}(h/j/k/l to resize)${NC}"
    echo -e "  ${BOLD}Ctrl+h${NC}  Move mode    ${DIM}(h/j/k/l to move pane)${NC}"
    echo -e "  ${BOLD}Ctrl+s${NC}  Scroll mode"
    echo -e "  ${BOLD}Ctrl+o${NC}  Session mode"
    echo ""
    echo -e "${BLUE}${BOLD}  Neovim${NC}"
    echo -e "  ${DIM}──────────────────────────────────────${NC}"
    echo -e "  ${GREEN}Space sf${NC}  find files       ${GREEN}Space sg${NC}  grep"
    echo -e "  ${GREEN}Space /${NC}   search buffer    ${GREEN}Space sr${NC}  resume search"
    echo -e "  ${GREEN}\\\\${NC}        toggle neo-tree   ${GREEN}Space gg${NC}  lazygit"
    echo -e "  ${GREEN}Ctrl+\\\\${NC}   floating terminal"
    echo -e "  ${GREEN}Space f${NC}   format           ${GREEN}Space u${NC}   undo tree"
    echo -e "  ${GREEN}Space xx${NC}  diagnostics      ${GREEN}Space tH${NC}  terminal split"
    echo -e "  ${GREEN}Shift+h/l${NC}  prev/next buffer"
    echo -e "  ${GREEN}s${NC}         flash jump       ${GREEN}S${NC}         flash treesitter"
    echo -e "  ${GREEN}Space ma${NC}  harpoon add      ${GREEN}Space mm${NC}  harpoon menu"
    echo -e "  ${GREEN}Space m1-5${NC}  harpoon jump"
    echo -e "  ${GREEN}F5${NC}        debug start     ${GREEN}F7${NC}        debug UI"
    echo -e "  ${GREEN}F1/F2/F3${NC}  step into/over/out"
    echo -e "  ${GREEN}Space db${NC}  toggle breakpoint"
    echo ""
    echo -e "${BLUE}${BOLD}  Neovim pass-through (autolock)${NC}"
    echo -e "  ${DIM}──────────────────────────────────────${NC}"
    echo -e "  ${DIM}Zellij auto-locks when a pane runs nvim/fzf/lazygit/${NC}"
    echo -e "  ${DIM}yazi/less/man/git, so their Ctrl keys (Ctrl+o jump,${NC}"
    echo -e "  ${DIM}Ctrl+t tag, Ctrl+b page up, Ctrl+n/p completion) work.${NC}"
    echo -e "  ${GREEN}Ctrl+g${NC}  Take manual control / hand it back"
    echo -e "  ${DIM}e.g. over a nvim pane: Ctrl+g, then Ctrl+p x to close.${NC}"
    echo ""
    echo -e "${BLUE}${BOLD}  Shell${NC}"
    echo -e "  ${DIM}──────────────────────────────────────${NC}"
    echo -e "  ${GREEN}ls${NC}  eza       ${GREEN}cat${NC}  bat       ${GREEN}vi${NC}  nvim"
    echo -e "  ${GREEN}ll${NC}  ls -la    ${GREEN}lt${NC}   tree      ${GREEN}lg${NC}  lazygit"
    echo ""
}

# ── Doctor ──────────────────────────────────────────
cmd_doctor() {
    banner
    echo -e "${BOLD}Checking installation...${NC}"
    echo ""

    local all_good=true
    if ! source_preflight; then all_good=false; fi

    check_tool() {
        if [ -x "$(command -v "$1" 2>/dev/null)" ]; then
            local ver
            if ! ver=$("$1" --version 2>&1); then
                echo "Required tool failed: $1" >&2
                all_good=false
                return
            fi
            ver="${ver%%$'\n'*}"
            echo -e "  ${GREEN}✓${NC} $1 ${DIM}$ver${NC}"
        else
            echo -e "  ${RED}✗${NC} $1 ${RED}not found${NC}"
            all_good=false
        fi
    }

    check_tool nvim
    check_tool zellij
    check_tool yazi
    check_tool lazygit
    check_tool fzf
    check_tool zoxide
    check_tool rg
    check_tool fd
    check_tool bat
    check_tool eza
    check_tool delta
    check_tool starship
    check_tool btop
    check_tool tldr
    check_tool gh
    check_tool jq
    check_tool atac
    check_tool hurl
    check_tool lazysql

    echo ""

    # Check for terminal conflicts
    echo -e "${BOLD}Checking for terminal conflicts...${NC}"
    echo ""

    if command -v wezterm &>/dev/null; then
        echo -e "  ${YELLOW}!${NC}  WezTerm detected — disable its multiplexer for best Zellij experience"
        echo -e "     Set \`enable_tab_bar = false\` in WezTerm config"
    fi

    if command -v tmux &>/dev/null && [ -z "$TMUX" ]; then
        echo -e "  ${YELLOW}!${NC}  Tmux found — use Zellij OR tmux, not both (Zellij is recommended)"
    fi

    echo ""

    # Check configs
    echo -e "${BOLD}Checking configs...${NC}"
    echo ""

    check_config() {
        if [ -e "$1" ]; then
            echo -e "  ${GREEN}✓${NC} $2"
        else
            echo -e "  ${RED}✗${NC} $2 ${RED}missing${NC} — run ${BOLD}trmnl setup${NC}"
            all_good=false
        fi
    }

    check_config "$CONFIG_DIR/nvim/init.lua" "nvim"
    check_config "$CONFIG_DIR/zellij/config.kdl" "zellij"
    check_config "$CONFIG_DIR/yazi/yazi.toml" "yazi"
    check_config "$CONFIG_DIR/starship.toml" "starship"

    # Check gitconfig include
    if git config --file "$HOME/.gitconfig" --get-all include.path 2>/dev/null | grep -Fxq "$TRMNL_DIR/trmnl-gitconfig"; then
        echo -e "  ${GREEN}✓${NC} gitconfig (trmnl include)"
    else
        echo -e "  ${RED}✗${NC} gitconfig ${RED}trmnl include missing${NC} — run ${BOLD}trmnl setup${NC}"
        all_good=false
    fi

    # Check zshrc block
    if [ "$(grep -Fxc "$SHELL_START" "$HOME/.zshrc" 2>/dev/null)" = 1 ] && [ "$(grep -Fxc "$SHELL_END" "$HOME/.zshrc" 2>/dev/null)" = 1 ] && shell_content "$HOME/.zshrc" /dev/null; then
        echo -e "  ${GREEN}✓${NC} zshrc (trmnl block)"
    else
        echo -e "  ${RED}✗${NC} zshrc ${RED}trmnl block missing${NC} — run ${BOLD}trmnl setup${NC}"
        all_good=false
    fi

    echo ""

    # Optional font detection; either fontconfig or macOS user fonts suffice.
    local font_found=false font
    if fc-list 2>/dev/null | grep -qi "JetBrainsMono Nerd"; then font_found=true; fi
    for font in "$HOME/Library/Fonts/"*JetBrainsMono*; do
        [ ! -e "$font" ] || font_found=true
    done
    if [ "$font_found" = true ]; then
        echo -e "  ${GREEN}✓${NC} JetBrains Mono Nerd Font"
    else
        echo -e "  ${YELLOW}?${NC} JetBrains Mono Nerd Font ${DIM}(may still be installed)${NC}"
    fi

    echo ""
    if [ "$all_good" = true ]; then
        echo -e "  ${GREEN}${BOLD}Everything looks good!${NC}"
    else
        echo -e "  ${YELLOW}${BOLD}Some items need attention.${NC}"
    fi
    echo ""
    [ "$all_good" = true ]
}

# ── Uninstall ───────────────────────────────────────
cmd_uninstall() (
    set -e
    umask 077
    item='' dest='' entry='' txn=''
    read -p "Remove owned trmnl configuration links? [y/N] " -n 1 -r
    echo
    [[ $REPLY =~ ^[Yy]$ ]] || return 0
    case "$CONFIG_DIR" in /*) ;; *) echo 'XDG_CONFIG_HOME must be absolute' >&2; exit 1 ;; esac
    [ ! -L "$STATE_DIR" ] || { echo 'Refusing symlink journal' >&2; exit 1; }
    for item in .zshrc .gitconfig; do
        [ ! -L "$HOME/$item" ] && { [ ! -e "$HOME/$item" ] || [ -f "$HOME/$item" ]; } || {
            echo "Refusing non-regular configuration file: $item" >&2; exit 1;
        }
    done
    refuse_pending_recovery
    txn="$(mktemp -d "$HOME/.trmnl-uninstall.XXXXXXXX")"
    prepare_transaction uninstall
    if [ -f "$HOME/.zshrc" ]; then
        cp -p "$HOME/.zshrc" "$txn/old-zshrc"
        shell_content "$HOME/.zshrc" "$txn/zshrc"
        chmod "$(stat -f %Lp "$HOME/.zshrc" 2>/dev/null || stat -c %a "$HOME/.zshrc")" "$txn/zshrc"
    fi
    if [ -f "$HOME/.gitconfig" ]; then
        cp -p "$HOME/.gitconfig" "$txn/old-gitconfig"
        cp -p "$HOME/.gitconfig" "$txn/gitconfig"
        git config --file "$txn/gitconfig" --fixed-value --unset-all include.path "$TRMNL_DIR/trmnl-gitconfig" || [ "$?" -eq 5 ]
    fi
    for item in nvim zellij yazi starship.toml; do
        dest="$CONFIG_DIR/$item"; entry="$STATE_DIR/$item"
        if [ ! -L "$entry" ] && [ -f "$entry/owned" ] && [ ! -L "$entry/owned" ] &&
            [ -L "$dest" ] && [ "$(readlink "$dest")" = "$(cat "$entry/owned")" ]; then
            mv "$dest" "$txn/removed-$item"
            if path_exists "$entry/previous"; then
                : > "$txn/previous-$item"
                mv "$entry/previous" "$dest"
            fi
            # Retire by move, retaining the exact entry until every publication
            # succeeds. Rollback returns it before returning its predecessor.
            mv "$entry" "$txn/entries/$item"
        fi
    done
    if [ -f "$txn/gitconfig" ]; then
        : > "$txn/publish-gitconfig"
        mv "$txn/gitconfig" "$HOME/.gitconfig"
    fi
    if [ -f "$txn/zshrc" ]; then
        : > "$txn/publish-zshrc"
        mv "$txn/zshrc" "$HOME/.zshrc"
    fi
    echo 'Removed owned links; unrelated replacements and retained journal history were preserved.'
)

# ── Help ────────────────────────────────────────────
cmd_help() {
    banner
    echo -e "  ${BOLD}Usage:${NC} trmnl <command>"
    echo ""
    echo -e "  ${BOLD}Commands:${NC}"
    echo -e "    ${GREEN}setup${NC}       Install configs and link everything"
    echo -e "    ${GREEN}keys${NC}        Show keybind cheat sheet"
    echo -e "    ${GREEN}doctor${NC}      Check if everything is installed"
    echo -e "    ${GREEN}uninstall${NC}   Remove config symlinks"
    echo -e "    ${GREEN}recover${NC}     Retry recovery using a retained transaction path"
    echo -e "    ${GREEN}help${NC}        Show this message"
    echo -e "    ${GREEN}version${NC}     Show version"
    echo ""
}

# ── Launch ──────────────────────────────────────────
cmd_launch() {
    # First run — auto-setup if configs aren't linked yet
    if [ ! -L "$CONFIG_DIR/zellij" ] && [ -d "$TRMNL_DIR/zellij" ]; then
        cmd_setup
        echo -e "  ${DIM}Starting Terminal IDE...${NC}"
        echo ""
    fi

    # Detect multiplexer: prefer Zellij, fallback to Tmux.
    # Run without `exec` so quitting the multiplexer returns to the shell
    # that ran `trmnl`, rather than closing the terminal outright.
    if command -v zellij &>/dev/null; then
        zellij
    elif command -v tmux &>/dev/null; then
        echo -e "  ${YELLOW}→${NC} Zellij not found, using Tmux instead"
        tmux
    else
        echo -e "  ${RED}✗${NC} No multiplexer found (Zellij or Tmux required)"
        echo -e "    Install with: brew install zellij"
        exit 1
    fi
}

# ── Main ────────────────────────────────────────────
case "${1:-launch}" in
    setup)      cmd_setup ;;
    keys)       cmd_keys ;;
    doctor)     cmd_doctor ;;
    uninstall)  cmd_uninstall ;;
    recover)    cmd_recover "${2:-}" ;;
    version)    echo "trmnl v${TRMNL_VERSION}" ;;
    help|-h|--help) cmd_help ;;
    launch)     cmd_launch ;;
    *)          cmd_help ;;
esac
